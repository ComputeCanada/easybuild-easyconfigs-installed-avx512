# Built with EasyBuild version 5.4.0 on 2026-09-03_18-58-41
easyblock = 'MakeCp'

name = 'VASP'
version = '6.6.1'

homepage = 'http://www.vasp.at'
description = """ The Vienna Ab initio Simulation Package (VASP) is a computer program used for 
atomic-scale materials modelling, including electronic structure calculations and 
quantum-mechanical molecular dynamics simulations based on Density Functional Theory (DFT). In 
this version, the original VASP code has been enhanced with scripts and modules for 
transition-state calculations using VTSTTools, as well as VASPsol for implicit solvation calculations. 
This version also includes support for HDF5, Wannier90, Libbeef, ELPA, DFT-D4, DFT-D3, and Libxc."""

local_vstat = 'vtstcode-%(version)s'
local_vtstscripts = 'vtstscripts-1040.tgz'
local_binfiles = ['vasp_std', 'vasp_gam', 'vasp_ncl']

toolchain = {'name': 'iimpi', 'version': '2025b'}
builddependencies = [
    ('FFTW', '3.3.10'),
    ('wannier90', '3.1.0'),
    ('HDF5', '1.14.2'),
    ('ScaLAPACK', '2.2.0', '-fb'),
    ('FlexiBLAS', '3.4.5'),
    ('libbeef', '0.1.2'),
    ('ELPA', '2024.05.001'),
    ('dftd4', '3.7.0'),
    ('simple-dftd3', '1.0.0'),
    ('libxc', '7.0.0'),
]



source_urls = ['https://github.com/henniggroup/VASPsol/archive/', 'http://theory.cm.utexas.edu/code/vtstscripts_old', 'https://github.com/henkelmangroup/vtstcode/releases/download/v6.6.1/']
sources = ['%(namelower)s.%(version)s.tgz', 'V1.0.tar.gz', '%s' %local_vtstscripts, '%s.tar.gz' %local_vstat]
patches = ['%(namelower)s-%(version)s.patch','%(namelower)s-%(version)s-vtsttools.patch', '%(namelower)s-%(version)s-VASPsol.patch']
checksums = [
    {'%(namelower)s.%(version)s.tgz': '261f9c1fd730468106191afeb185821d67cb7a58c982f6e063824dd5432106b0'},
    {'V1.0.tar.gz': '77f9934c4db433d574d6b317fc73d0d3628e4a6b8b58e7eb7fabc22225e90c26'},
    {'vtstscripts-1040.tgz': 'b5da06c8bbff762498b5b5caf3f114df7752f8d83d0d51f0ccfc67a246e2e28e'},
    {'vtstcode-6.6.1.tar.gz': '5ebdf889bd59c6e2f53d42d12cbe7c97966f9465bddffe7bc39d17d6c9720e91'},
    {'%(namelower)s-%(version)s.patch': 'fe34ed5670b0ab484f8c2aaac928bcc8dd2779d944e830dce0eb208c8455dfec'},
    {'%(namelower)s-%(version)s-vtsttools.patch': '8fec26b23eb4d43d2760c8ceb694587f1128be88be123eada91ed32f6f744c8d'},
    {'%(namelower)s-%(version)s-VASPsol.patch': '14f550df5b1fec980393db6ed1c3d44540ee811b6f0979bcfa13ba11c5771279'},
]

# Vasp is proprietary software, see http://www.vasp.at/index.php/faqs on how to get access to the code
prebuildopts = 'cp arch/makefile.include.intel ./makefile.include && '
prebuildopts += 'cp  -r ../vtstcode%s/* src  && ' %version
prebuildopts += 'cp ../VASPsol-1.0/src/solvation.F src  && '

#Following is part of the vaspSol modifcation that  cannot be  patched through a patched file.
prebuildopts += 'sed -i "s/M_sum_s(SP_GRIDC%COMM,1,Ecorr4,0,0,0))/M_sum_1(SP_GRIDC%COMM,Ecorr4))/g" src/solvation.F && '
prebuildopts += 'sed -i "s/M_sum_s(SP_GRIDC%COMM,1,Ecorr3,0,0,0))/M_sum_1(SP_GRIDC%COMM,Ecorr3))/g" src/solvation.F && '
import os
if os.getenv('RSNT_ARCH') == 'avx512':
  local_vasp_target_cpu ='"-march=x86-64-v4 -axCore-AVX512"'
elif os.getenv('RSNT_ARCH') == 'avx2':
  local_vasp_target_cpu ='"-march=x86-64-v3 -axCore-AVX2"'

prebuildopts += 'unset LIBS && '
build_cmd = 'make VASP_TARGET_CPU=%s' % local_vasp_target_cpu

prebuildopts += 'unset LIBS && '

postinstallcmds = ["chmod -R o-rwx %(installdir)s && ln -f -s /opt/software/easybuild/2017/avx2/MPI/intel2016.4/openmpi2.1/vasp/pseudopotentials %(installdir)s/pseudopotentials"]
parallel = 1

files_to_copy = [(['bin/%s' % x for x in local_binfiles], 'bin')]
sanity_check_paths = {
    'files': ['bin/%s' % x for x in local_binfiles],
    'dirs': []
}
moduleclass = 'phys'


