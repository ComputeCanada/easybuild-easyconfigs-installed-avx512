# Built with EasyBuild version 5.4.1 on 2026-11-16_23-33-33
name = 'OpenFOAM'
version = '14'

homepage = 'https://www.openfoam.org/'
description = """OpenFOAM is a free, open source CFD software package.
 OpenFOAM has an extensive range of features to solve anything from complex fluid flows
 involving chemical reactions, turbulence and heat transfer,
 to solid dynamics and electromagnetics."""

toolchain = {'name': 'gofb', 'version': '2026'}
toolchainopts = {'vectorize': False}

source_urls = ['https://github.com/OpenFOAM/OpenFOAM-%(version_major)s/archive']
sources = ['version-%(version)s.tar.gz']
patches = ['OpenFOAM-14-ThirdParty.patch']
checksums = [
    {'version-14.tar.gz': 'f9eaa89b1f1986ff8b7ce04cf5aaf11ceeeb05bd0c4e4fc3d4bfd199d56f82e9'},
    {'OpenFOAM-14-ThirdParty.patch': '41cd2bc11d91388858acb2b34c531210a8967268f80383f18ba5b95d833bbdb0'},
]

builddependencies = [
    ('Bison', '3.8.2'),
    ('CMake', '4.4.2'),
    ('flex', '2.6.4'),
    ('Python', '3.15'),
]

dependencies = [
    ('ncurses', '6.6'),
    # OpenFOAM requires 64 bit METIS using 32 bit indexes (array indexes)
    ('METIS', '5.1.0'),
    ('SCOTCH', '7.0.18'),
    ('CGAL', '6.2.1'),
    ('ParaView', '6.2.0'),
    ('gnuplot', '6.0.3'),
    ('Zoltan', '3.901'),
]

# disable PARMETIS (in restricted repo)
prebuildopts = 'sed -i "s/export PARMETIS_TYPE=ThirdParty/export PARMETIS_TYPE=none/" etc/bashrc && '
prebuildopts += 'sed -i "s/export PARMETIS_/#export PARMETIS_/" etc/config.sh/parMetis && '
prebuildopts += 'export PARMETIS_TYPE=none && '

moduleclass = 'cae'

# Build statistics
