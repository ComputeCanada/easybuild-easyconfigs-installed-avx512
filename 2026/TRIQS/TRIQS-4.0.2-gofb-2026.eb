sanity_check_paths = {
    'files': ['bin/dmftproj', 'bin/init_dmftpr', 'bin/plot_maxent', 'bin/plovasp',
              'bin/solid_dmft', 'bin/vasp_dmft', 'lib/libtriqs.%s' % SHLIB_EXT],
    'dirs': ['include/triqs', 'include/itertools', 'include/mpi', 'include/cpp2py',
             'lib/python%(pyshortver)s/site-packages', 'share'],
}

sanity_check_commands = [
    "c++2cxx --help",
    "c++2py --help",
    "c++2rst --help",
    "python -c 'import triqs'"
]

modextrapaths = {
    'EBPYTHONPREFIXES': [''],
}

moduleclass = 'phys'

