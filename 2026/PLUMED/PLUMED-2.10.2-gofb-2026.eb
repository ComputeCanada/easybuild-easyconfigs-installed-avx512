easyblock = 'ConfigureMake'

name = 'PLUMED'
version = '2.10.2'
local_ext_version = '2.10.0'

homepage = 'https://www.plumed.org'
description = """PLUMED is an open source library for free energy calculations in molecular systems which
 works together with some of the most popular molecular dynamics engines. Free energy calculations can be
 performed as a function of many order parameters with a particular  focus on biological problems, using
 state of the art methods such as metadynamics, umbrella sampling and Jarzynski-equation based steered MD.
 The software, written in C++, can be easily interfaced with both fortran and C/C++ codes.
"""

toolchain = {'name': 'gofb', 'version': '2026'}
toolchainopts = {'usempi': 'True'}

source_urls = ['https://github.com/%(namelower)s/plumed2/releases/download/v%(version)s/']
sources = [SOURCE_TGZ]
# checksums are now on checksums.json

builddependencies = [
]

dependencies = [
    ('FFTW', '3.3.11'),
    ('GSL', '2.8'),
    ('libmatheval', '1.1.11'),
    ('SciPy-Stack', '2026b', '', ('GCCcore', '15.3.0')),
    ('Boost', '1.92.0'),
    ('XDRfile', '1.1.4'),
]
multi_deps = {
    'Python': [
        '3.14', '3.15'
    ]}

preconfigopts = 'env FC=$MPIF90 LIBS="$LIBLAPACK $LIBS" '
configopts = " ".join([
    "--exec-prefix=%(installdir)s",
    "--enable-gsl",
    "--enable-modules=all",
    # "--enable-boost_graph", # Bug in 2.10.x: https://github.com/plumed/plumed2/issues/1294 & removed in 2.11
    "--enable-boost_serialization",
    "--enable-asmjit",
])

prebuildopts = "source sourceme.sh && "

# copy GROMACS patches to applying them to latest GROMACS releases.
# preinstallopts =  'cp    patches/gromacs-2024.3.config   patches/gromacs-2024.6.config && '
# preinstallopts += 'cp -r patches/gromacs-2024.3.diff     patches/gromacs-2024.6.diff   && '

multi_deps_load_default = False
multi_deps_extensions_only = True
exts_defaultclass = 'PythonPackage'
exts_filter = (
    "python -c 'import %(ext_name)s'",
    '',
)

exts_list = [
    ('plumed', local_ext_version, {
        'prebuildopts': '',
        'preinstallopts': '',
        'source_urls': ['https://pypi.python.org/packages/source/%(nameletter)s/%(name)s'],
        # checksums are now on checksums.json
        'use_pip': True,
    }),
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s', 'lib/libplumedKernel.%s' % SHLIB_EXT, 'lib/libplumed.%s' % SHLIB_EXT ],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["python%(pyshortver)s -c 'import %(namelower)s'"]

modextrapaths = {
    'EBPYTHONPREFIXES': [''],
}
modextravars = {
    'PLUMED_KERNEL': '%(installdir)s/lib/libplumedKernel.' + SHLIB_EXT,
    'PLUMED_ROOT': '%(installdir)s/lib/%(namelower)s',
    'PLUMED_VERSION': '%(version)s',
}

moduleclass = 'chem'
# vim: ft=python

# Build statistics
