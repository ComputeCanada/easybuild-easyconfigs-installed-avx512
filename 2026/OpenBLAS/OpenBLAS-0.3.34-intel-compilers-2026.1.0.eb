# Built with EasyBuild version 5.4.0 on 2026-09-04_15-00-56
name = 'OpenBLAS'
version = '0.3.34'

homepage = 'https://www.openblas.net/'
description = "OpenBLAS is an optimized BLAS library based on GotoBLAS2 1.13 BSD version."

toolchain = {'name': 'intel-compilers', 'version': '2026.1.0'}
toolchainopts = {'precise': True, 'extra_cflags': '-fp-speculation=safe'}

source_urls = [
    # order matters, trying to download the large.tgz/timing.tgz LAPACK tarballs from GitHub causes trouble
    'https://www.netlib.org/lapack/timing/',
    'https://github.com/xianyi/OpenBLAS/archive/',
]
sources = ['v%(version)s.tar.gz']
patches = [
    ('large.tgz', '.'),
    ('timing.tgz', '.'),
    'OpenBLAS-0.3.15_workaround-gcc-miscompilation.patch',
    'OpenBLAS-0.3.21_fix-order-vectorization.patch',
]
checksums = [
    {'v0.3.34.tar.gz': 'cd7e129868320cc2d033afa920e31202dfe0b8066a5b66661900ccc0f197dfed'},
    {'large.tgz': 'f328d88b7fa97722f271d7d0cfea1c220e0f8e5ed5ff01d8ef1eb51d6f4243a1'},
    {'timing.tgz': '999c65f8ea8bd4eac7f1c7f3463d4946917afd20a997807300fe35d70122f3af'},
    {'OpenBLAS-0.3.15_workaround-gcc-miscompilation.patch':
     'e6b326fb8c4a8a6fd07741d9983c37a72c55c9ff9a4f74a80e1352ce5f975971'},
    {'OpenBLAS-0.3.21_fix-order-vectorization.patch':
     '08af834e5d60441fd35c128758ed9c092ba6887c829e0471ecd489079539047d'},
]

builddependencies = [
    ('make', '4.4.1'),
    # required by LAPACK test suite
    ('Python', '3.14.7'),
]

prebuildopts = "declare -A ARCH_MAP=( [avx2]='TARGET=HASWELL' [avx512]='TARGET=SKYLAKEX' ) && "
prebuildopts += 'if [ "$RSNT_ARCH" == "avx2" ]; then printf "DYNAMIC_ARCH=1\\nDYNAMIC_LIST=HASWELL ZEN SKYLAKEX COOPERLAKE SAPPHIRERAPIDS\\n" >> Makefile.rule; fi && '
prebuildopts += 'if [ "$RSNT_ARCH" == "avx512" ]; then printf "DYNAMIC_ARCH=1\\nDYNAMIC_LIST=SKYLAKEX COOPERLAKE SAPPHIRERAPIDS\\n" >> Makefile.rule; fi && '
prebuildopts += "sed -i 's/$(FFLAGS) $(EXTRALIB)/$(FFLAGS) $(EXTRALIB) -nofor-main/' Makefile && "
buildopts = '${ARCH_MAP[$RSNT_ARCH]} NUM_THREADS=256'
installopts = buildopts

run_lapack_tests = True
max_failing_lapack_tests_num_errors = 1100

# extensive testing can be enabled by uncommenting the line below
# runtest = 'PATH=.:$PATH lapack-timing'

moduleclass = 'numlib'

# Build statistics
buildstats = [{
